# ALDA environment example
# Copy this file to .env.local before running the app.

# Supported values: mock, ollama, openai
AI_PROVIDER=mock

# AI request resilience
# Timeout per attempt in milliseconds (default: 15000)
AI_REQUEST_TIMEOUT_MS=15000
# Number of retries after the first attempt (default: 1, maximum: 3)
AI_REQUEST_MAX_RETRIES=1
# Initial retry delay in milliseconds; exponential backoff is applied (default: 250)
AI_REQUEST_RETRY_DELAY_MS=250

# OpenAI cloud provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Ollama local provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=

# Optional application settings
NEXT_PUBLIC_APP_NAME=ALDA
NEXT_PUBLIC_APP_URL=http://localhost:3000
